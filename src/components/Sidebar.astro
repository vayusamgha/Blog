---
import type { getPosts, getTags, getStats, getArchives, getRecentPosts } from "../utils/posts";

interface Props {
  posts: Awaited<ReturnType<typeof getPosts>>;
  tags: ReturnType<typeof getTags>;
  stats: Awaited<ReturnType<typeof getStats>>;
  archives: Awaited<ReturnType<typeof getArchives>>;
  recentPosts: Awaited<ReturnType<typeof getRecentPosts>>;
}

const { posts, tags, stats, archives, recentPosts } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
---

<aside class="space-y-5">
  <!-- Profile -->
  <div class="bg-surface rounded-2xl border border-border p-5 text-center">
    <img
      src={`${base}/image.png`}
      alt="avatar"
      class="w-20 h-20 rounded-full mx-auto mb-3 object-cover border-2 border-border"
    />
    <h3 class="font-semibold text-text mb-3">PurushaVayu</h3>
    <div class="flex justify-center gap-6 mb-4">
      <div>
        <span class="block text-2xl font-bold text-text">{stats.count}</span>
        <span class="text-xs text-text-muted">文章</span>
      </div>
      <div>
        <span class="block text-2xl font-bold text-text">{stats.runningDays}</span>
        <span class="text-xs text-text-muted">运行天数</span>
      </div>
    </div>
    <div class="flex justify-center gap-2">
      <a href="https://github.com/vayusamgha" target="_blank" rel="noopener"
         class="w-9 h-9 flex items-center justify-center rounded-lg bg-bg text-text-muted hover:text-text hover:bg-border/50 transition-colors"
         aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="mailto:vayusamgha@gmail.com"
         class="w-9 h-9 flex items-center justify-center rounded-lg bg-bg text-text-muted hover:text-text hover:bg-border/50 transition-colors"
         aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
    </div>
  </div>

  <!-- Announcement -->
  <div class="bg-accent/5 border border-accent/20 rounded-2xl p-4">
    <p class="text-sm text-text leading-relaxed">
      欢迎来到伐由伽蓝。这里记录技术笔记与数学思考。
    </p>
  </div>

  <!-- Recent Posts -->
  <div class="bg-surface rounded-2xl border border-border p-5">
    <h4 class="flex items-center gap-2 text-sm font-semibold text-text mb-3 pb-3 border-b border-border">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg> 最新文章
    </h4>
    <ul class="space-y-3">
      {recentPosts.map((post) => (
        <li>
          <a
            href={`${base}/posts/${post.slug}`}
            class="text-sm text-text hover:text-accent transition-colors leading-snug line-clamp-1"
          >
            {post.data.title}
          </a>
          <time class="block text-xs text-text-muted mt-0.5">
            {post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </li>
      ))}
    </ul>
  </div>

  <!-- Tags -->
  <div class="bg-surface rounded-2xl border border-border p-5">
    <h4 class="flex items-center gap-2 text-sm font-semibold text-text mb-3 pb-3 border-b border-border">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0"><path d="M12 2H2v10l9.17 9.17a2 2 0 0 0 2.83 0l7-7a2 2 0 0 0 0-2.83L12 2Z"/><path d="M7 7h.01"/></svg> 标签
    </h4>
    <div class="flex flex-wrap gap-2">
      {tags.slice(0, 12).map(({ tag, count }) => (
        <a
          href={`${base}/tags/${tag}`}
          class="px-2.5 py-1 text-xs rounded-lg bg-bg text-text-muted hover:text-accent hover:bg-accent/5 transition-colors"
        >
          {tag}
          <span class="ml-1 opacity-50">{count}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Archives -->
  {
    archives.length > 0 && (
      <div class="bg-surface rounded-2xl border border-border p-5">
        <h4 class="flex items-center gap-2 text-sm font-semibold text-text mb-3 pb-3 border-b border-border">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted shrink-0"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> 归档
        </h4>
        <ul class="space-y-1.5">
          {archives.slice(0, 6).map(([month, count]) => (
            <li class="flex items-center justify-between text-sm">
              <span class="text-text-muted">{month}</span>
              <span class="text-xs text-text-muted bg-bg px-2 py-0.5 rounded-full">{count}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Site info -->
  <div class="text-center text-xs text-text-muted space-y-1 pb-2">
    <p>文章 {stats.count} · 运行 {stats.runningDays} 天</p>
    <p class="opacity-60">Astro + Tailwind + KaTeX</p>
  </div>
</aside>
