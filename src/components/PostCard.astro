---
import type { CollectionEntry } from "astro:content";
import TagBadge from "./TagBadge.astro";

const { post, index = 0 } = Astro.props;
const { title, date, tags, description } = post.data;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
const href = `${base}/posts/${post.slug}`;
---

<article
  class="glass rounded-2xl p-6 group animate-card-enter"
  style={`animation-delay: ${index * 60}ms`}
>
  <a href={href} class="block">
    <time class="text-xs text-text-muted mb-2 block">
      {date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
    </time>
    <h2 class="text-lg font-serif font-semibold text-text group-hover:text-accent transition-colors leading-snug mb-2">
      {title}
    </h2>
    {
      description && (
        <p class="text-sm text-text-muted leading-relaxed line-clamp-2">
          {description}
        </p>
      )
    }
  </a>
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4">
        {tags.map((tag) => (
          <a href={`${base}/tags/${tag}`}>
            <TagBadge tag={tag} />
          </a>
        ))}
      </div>
    )
  }
</article>
