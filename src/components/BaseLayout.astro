---
import "../styles/global.css";

const { title } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="伐由伽蓝 — 技术、数学与思考" />
    <title>{title ? `${title} — 伐由伽蓝` : "伐由伽蓝"}</title>
    <link rel="icon" href={`${base}/image.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=LXGW+WenKai:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.18/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-border bg-surface/80 backdrop-blur-sm sticky top-0 z-10">
      <nav class="max-w-4xl mx-auto px-5 h-14 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href={base} class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors">
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-accent/10 text-accent text-base font-bold">
              &sum;
            </span>
            伐由伽蓝
          </a>
        </div>
        <div class="flex items-center gap-4 text-sm text-text-muted">
          <button
            id="search-toggle"
            class="hover:text-text transition-colors cursor-pointer flex items-center gap-1"
            aria-label="搜索"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="hidden sm:inline">搜索</span>
          </button>
          <a href={`${base}/tags`} class="hover:text-text transition-colors">标签</a>
          <a href={`${base}/rss.xml`} class="hover:text-text transition-colors">RSS</a>
        </div>
      </nav>
    </header>

    <!-- Search overlay -->
    <div id="search-overlay" data-base={base} class="fixed inset-0 z-50 hidden" style="background: rgba(0,0,0,0.3); backdrop-filter: blur(4px);">
      <div class="max-w-xl mx-auto mt-24 px-5">
        <div class="bg-surface rounded-2xl shadow-2xl border border-border p-5">
          <div class="relative mb-4">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              id="search-input"
              type="text"
              placeholder="搜索笔记..."
              autocomplete="off"
              class="w-full pl-10 pr-4 py-3 text-base font-sans rounded-xl border border-border bg-bg text-text placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
            />
          </div>
          <div id="search-results" class="max-h-80 overflow-y-auto"></div>
          <div id="search-empty" class="hidden text-center text-sm text-text-muted py-8">
            输入关键词搜索笔记
          </div>
        </div>
      </div>
    </div>

    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border py-8 text-center text-sm text-text-muted">
      <p>&copy; {new Date().getFullYear()} &mdash; Built with Astro &amp; KaTeX</p>
    </footer>

    <script src={`${base}/pagefind/pagefind.js`}></script>
    <script is:inline>
      (function() {
        const overlay = document.getElementById("search-overlay");
        const base = overlay.dataset.base;
        const toggle = document.getElementById("search-toggle");
        const input = document.getElementById("search-input");
        const results = document.getElementById("search-results");
        const empty = document.getElementById("search-empty");

        let pagefind = null;
        let debounceTimer = null;

        async function initPagefind() {
          if (pagefind) return;
          pagefind = await import(base + "/pagefind/pagefind.js");
        }

        function openSearch() {
          overlay.classList.remove("hidden");
          document.body.style.overflow = "hidden";
          initPagefind();
          setTimeout(() => input.focus(), 100);
        }

        function closeSearch() {
          overlay.classList.add("hidden");
          document.body.style.overflow = "";
          input.value = "";
          results.innerHTML = "";
          empty.classList.remove("hidden");
        }

        async function doSearch(query) {
          if (!pagefind || !query.trim()) {
            results.innerHTML = "";
            empty.classList.remove("hidden");
            return;
          }

          const search = await pagefind.search(query.trim());
          if (!search || search.results.length === 0) {
            results.innerHTML = '<p class="text-center text-sm text-text-muted py-4">无结果</p>';
            empty.classList.add("hidden");
            return;
          }

          empty.classList.add("hidden");
          const items = await Promise.all(search.results.slice(0, 8).map(async (r) => {
            const data = await r.data();
            return { ...data, id: r.id };
          }));

          results.innerHTML = items.map((item) => `
            <a href="${item.url}" class="block px-3 py-3 -mx-3 rounded-xl hover:bg-bg transition-colors border-b border-border last:border-0">
              <h4 class="text-sm font-semibold text-text mb-1">${item.meta?.title || item.url}</h4>
              <p class="text-xs text-text-muted line-clamp-2">${item.excerpt || ""}</p>
            </a>
          `).join("");
        }

        toggle.addEventListener("click", openSearch);

        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) closeSearch();
        });

        input.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => doSearch(input.value), 200);
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            if (!overlay.classList.contains("hidden")) closeSearch();
          }
          if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            openSearch();
          }
        });
      })();
    </script>
  </body>
</html>
