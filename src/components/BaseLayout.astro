---
import "../styles/global.css";

const { title } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="个人笔记 — 技术、数学与思考" />
    <title>{title ? `${title} — Notes` : "Notes"}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=LXGW+WenKai:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.18/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-border bg-surface/80 backdrop-blur-sm sticky top-0 z-10">
      <nav class="max-w-4xl mx-auto px-5 h-14 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href={base} class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-text hover:text-accent transition-colors">
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-accent/10 text-accent text-base font-bold">
              &sum;
            </span>
            ~/notes
          </a>
        </div>
        <div class="flex items-center gap-4 text-sm text-text-muted">
          <button
            id="search-toggle"
            class="hover:text-text transition-colors cursor-pointer flex items-center gap-1"
            aria-label="搜索"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="hidden sm:inline">搜索</span>
          </button>
          <a href={`${base}/tags`} class="hover:text-text transition-colors">标签</a>
          <a href={`${base}/rss.xml`} class="hover:text-text transition-colors">RSS</a>
        </div>
      </nav>
    </header>

    <!-- Search dialog -->
    <dialog id="search-dialog" class="search-dialog rounded-2xl shadow-2xl p-6 w-full max-w-xl mt-20 bg-surface backdrop:bg-black/30">
      <div class="flex items-center justify-between mb-4">
        <span class="text-sm font-medium text-text-muted">搜索笔记</span>
        <button id="search-close" class="text-text-muted hover:text-text transition-colors cursor-pointer" aria-label="关闭">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div id="search"></div>
    </dialog>

    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-border py-8 text-center text-sm text-text-muted">
      <p>&copy; {new Date().getFullYear()} &mdash; Built with Astro &amp; KaTeX</p>
    </footer>

    <script src={`${base}/pagefind/pagefind-ui.js`}></script>
    <script>
      window.addEventListener("DOMContentLoaded", () => {
        const dialog = document.getElementById("search-dialog");
        const toggle = document.getElementById("search-toggle");
        const close = document.getElementById("search-close");
        const container = document.getElementById("search");

        let instance = null;

        toggle.addEventListener("click", () => {
          dialog.showModal();
          if (!instance) {
            instance = new PagefindUI({
              element: "#search",
              baseUrl: `${base}/pagefind/`,
              showImages: false,
              showSubResults: true,
              resetStyles: false,
            });
          }
        });

        close.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && dialog.open) dialog.close();
          if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            dialog.showModal();
            if (!instance) {
              instance = new PagefindUI({
                element: "#search",
                baseUrl: `${base}/pagefind/`,
                showImages: false,
                showSubResults: true,
                resetStyles: false,
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
