---
import "../styles/global.css";
import NavBar from "./NavBar.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#dce7e1" />
    <meta name="description" content="伐由伽蓝 — 技术、数学与思考" />
    <title>{title ? `${title} — 伐由伽蓝` : "伐由伽蓝"}</title>
    <link rel="icon" href={`${base}/image.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400;1,8..60,500&family=LXGW+WenKai:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.18/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg">
    <!-- Top nav bar — 悬浮胶囊 -->
    <header
      id="top-bar"
      class="fixed top-5 inset-x-20 z-20 rounded-2xl lg:inset-x-auto lg:left-1/2 lg:-translate-x-1/2 lg:rounded-full lg:w-auto glass-nav"
    >
      <div class="px-3 sm:px-4 h-11 flex items-center justify-center gap-1 sm:gap-2">
        <a href={base} class="text-sm sm:text-base font-serif font-semibold text-text hover:text-accent transition-colors shrink-0 mr-1 sm:mr-3">
          伐由伽蓝
        </a>
        <NavBar currentPath={currentPath} />
      </div>
    </header>

    <!-- Search overlay -->
    <div id="search-overlay" data-base={base} class="fixed inset-0 z-50 hidden glass-overlay">
      <div class="max-w-xl mx-auto mt-24 px-5">
        <div class="bg-surface rounded-2xl shadow-2xl border border-border p-5">
          <div class="relative mb-4">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              id="search-input"
              type="text"
              placeholder="搜索笔记..."
              autocomplete="off"
              class="w-full pl-10 pr-4 py-3 text-base font-sans rounded-xl border border-border bg-bg text-text placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
            />
          </div>
          <div id="search-results" class="max-h-80 overflow-y-auto"></div>
          <div id="search-empty" class="text-center text-sm text-text-muted py-8">
            输入关键词搜索笔记
          </div>
        </div>
      </div>
    </div>

    <main class="flex-1 pt-20">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (function() {
        const overlay = document.getElementById("search-overlay");
        const base = overlay.dataset.base;
        const toggle = document.getElementById("search-toggle");
        const input = document.getElementById("search-input");
        const results = document.getElementById("search-results");
        const empty = document.getElementById("search-empty");

        let pagefind = null;
        let debounceTimer = null;

        async function initPagefind() {
          if (pagefind) return;
          try {
            pagefind = await import(base + "/pagefind/pagefind.js");
          } catch {
            pagefind = false;
          }
        }

        function openSearch() {
          overlay.classList.remove("hidden");
          document.body.style.overflow = "hidden";
          initPagefind();
          setTimeout(() => input.focus(), 100);
        }

        function closeSearch() {
          overlay.classList.add("hidden");
          document.body.style.overflow = "";
          input.value = "";
          results.innerHTML = "";
          empty.classList.remove("hidden");
          empty.style.display = "";
        }

        async function doSearch(query) {
          if (pagefind === false) {
            results.innerHTML = '<p class="text-center text-sm text-text-muted py-4">搜索仅在构建后可用（npm run build）</p>';
            empty.style.display = "none";
            return;
          }
          if (!pagefind || !query.trim()) {
            results.innerHTML = "";
            empty.classList.remove("hidden");
            empty.style.display = "";
            return;
          }

          const search = await pagefind.search(query.trim());
          if (!search || search.results.length === 0) {
            results.innerHTML = '<p class="text-center text-sm text-text-muted py-4">无结果</p>';
            empty.style.display = "none";
            return;
          }

          empty.style.display = "none";
          const items = await Promise.all(search.results.slice(0, 8).map(async (r) => {
            const data = await r.data();
            return { ...data, id: r.id };
          }));

          results.innerHTML = items.map((item) => `
            <a href="${item.url}" class="block px-3 py-3 -mx-3 rounded-xl hover:bg-bg transition-colors border-b border-border last:border-0">
              <h4 class="text-sm font-semibold text-text mb-1">${item.meta?.title || item.url}</h4>
              <p class="text-xs text-text-muted line-clamp-2">${item.excerpt || ""}</p>
            </a>
          `).join("");
        }

        if (toggle) {
          toggle.addEventListener("click", openSearch);
        }

        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) closeSearch();
        });

        if (input) {
          input.addEventListener("input", () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => doSearch(input.value), 200);
          });
        }

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            if (!overlay.classList.contains("hidden")) closeSearch();
          }
          if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            openSearch();
          }
        });
      })();
    </script>

    <!-- 顶栏滚动 -->
    <script is:inline>
      (function() {
        const bar = document.getElementById('top-bar');
        if (!bar) return;
        let ticking = false;

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              const y = window.scrollY;
              // 胶囊加深
              bar.classList.toggle('scrolled', y > 40);
              ticking = false;
            });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        // 初始触发
        onScroll();
      })();
    </script>
  </body>
</html>
