---
interface Props {
  tag: string;
  active?: boolean;
  href?: string;
}

const { tag, active = false, href } = Astro.props;
const baseClass = "inline-block px-3 py-1 text-xs font-medium rounded-full transition-colors";
const activeClass = "bg-accent text-white";
const inactiveClass = "bg-surface/70 border border-border text-text-muted hover:text-accent hover:border-accent/40 transition-all duration-200";

const TagOrLink = href ? "a" : "button";
---

<TagOrLink
  href={href}
  class={`${baseClass} ${active ? activeClass : inactiveClass}`}
>
  {tag}
</TagOrLink>
