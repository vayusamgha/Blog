---
import fs from "node:fs";
import path from "node:path";

interface Props {
  title?: string;
}

const { title = "Blog - VayuSamgha" } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";

let images: string[] = [];
try {
  const dir = path.join(process.cwd(), "public", "head_image");
  const files = fs.readdirSync(dir).filter((f) => /\.(jpg|jpeg|png|webp)$/i.test(f));
  images = files.map((f) => `${base}/head_image/${f}`);
} catch {}

const imagesJson = JSON.stringify(images);
---

<div
  id="hero-container"
  data-images={imagesJson}
  class="relative w-full h-72 sm:h-80 lg:h-96 flex items-center justify-center overflow-hidden"
>
  <div id="hero-fallback" class={`absolute inset-0 bg-gradient-to-br from-slate-700 to-slate-900${images.length > 0 ? " hidden" : ""}`}></div>
  <img id="hero-img" alt="" class={`absolute inset-0 w-full h-full object-cover${images.length === 0 ? " hidden" : ""}`} />
  <div class="absolute inset-0 bg-black/30"></div>
  <h1 class="relative z-10 text-4xl sm:text-5xl lg:text-6xl font-bold text-white text-center px-5" style="text-shadow: 0 2px 12px rgba(0,0,0,0.5);">
    {title}
  </h1>
</div>

<script>
  (function() {
    var container = document.getElementById('hero-container');
    var images = JSON.parse(container.dataset.images || '[]');
    if (!images.length) return;
    var key = 'hero-img-idx';
    var idx = parseInt(sessionStorage.getItem(key), 10);
    if (isNaN(idx) || idx < 0 || idx >= images.length) {
      idx = Math.floor(Math.random() * images.length);
      sessionStorage.setItem(key, String(idx));
    }
    document.getElementById('hero-img').src = images[idx];
  })();
</script>
