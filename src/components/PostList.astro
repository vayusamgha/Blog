---
import { getTags, type getPosts } from "../utils/posts";
import PostCard from "./PostCard.astro";

const { posts, activeTag } = Astro.props;
const tagSlug = activeTag as string | undefined;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";

const tags = getTags(posts);
---

<div id="post-list-root">
  <!-- Tag filter bar -->
  <div class="flex flex-wrap items-center gap-2 mb-8" id="tag-filter-bar">
    <button data-filter="all" class="filter-btn inline-block px-3 py-1 text-xs font-medium rounded-full transition-colors bg-accent text-white cursor-pointer">
      全部
    </button>
    {tags.map(({ tag, count }) => (
      <button data-filter={tag} class="filter-btn inline-block px-3 py-1 text-xs font-medium rounded-full transition-colors bg-surface border border-border text-text-muted hover:text-text hover:border-text-muted cursor-pointer">
        {tag} ({count})
      </button>
    ))}
  </div>

  <!-- Post grid -->
  <div id="post-grid" class="grid gap-5 sm:grid-cols-2">
    {posts.map((post) => (
      <div data-tags={post.data.tags.join(",")} class="post-card-wrapper">
        <PostCard post={post} />
      </div>
    ))}
  </div>

  <div id="no-results" class="hidden text-center text-text-muted py-16">
    <p class="text-lg">没有匹配的笔记</p>
  </div>
</div>

<script>
  (function () {
    const buttons = document.querySelectorAll("#tag-filter-bar .filter-btn");
    const cards = document.querySelectorAll(".post-card-wrapper");
    const noResults = document.getElementById("no-results");
    const grid = document.getElementById("post-grid");
    let active = "all";

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;

        if (filter === active) {
          // Deselect, show all
          active = "all";
        } else {
          active = filter;
        }

        // Update button styles
        buttons.forEach((b) => {
          if (b.dataset.filter === active) {
            b.classList.add("bg-accent", "text-white");
            b.classList.remove("bg-surface", "border", "border-border", "text-text-muted", "hover:text-text", "hover:border-text-muted");
          } else {
            b.classList.remove("bg-accent", "text-white");
            b.classList.add("bg-surface", "border", "border-border", "text-text-muted");
          }
        });

        // Filter cards
        let visible = 0;
        cards.forEach((card) => {
          const tags = card.dataset.tags?.split(",") || [];
          if (active === "all" || tags.includes(active)) {
            card.style.display = "";
            visible++;
          } else {
            card.style.display = "none";
          }
        });

        noResults.classList.toggle("hidden", visible > 0);
        grid.classList.toggle("hidden", visible === 0);
      });
    });
  })();
</script>
