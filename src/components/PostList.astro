---
import { getTags, type getPosts } from "../utils/posts";
import PostCard from "./PostCard.astro";
import TagBadge from "./TagBadge.astro";

const { posts, activeTag } = Astro.props;
const tagSlug = activeTag as string | undefined;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";

const tags = getTags(posts);
const filteredPosts = tagSlug
  ? posts.filter((p) => p.data.tags.includes(tagSlug))
  : posts;
---

<div>
  <!-- Tag filter bar -->
  <div class="flex flex-wrap items-center gap-2 mb-8">
    <a href={base}>
      <TagBadge tag="全部" active={!tagSlug} />
    </a>
    {tags.map(({ tag, count }) => (
      <a href={`${base}/tags/${tag}`}>
        <TagBadge tag={`${tag} (${count})`} active={tagSlug === tag} />
      </a>
    ))}
  </div>

  <!-- Post grid -->
  {
    filteredPosts.length === 0 ? (
      <div class="text-center text-text-muted py-16">
        <p class="text-lg">暂无笔记</p>
        <p class="text-sm mt-2">写一篇 Markdown 放到 src/content/posts 即可</p>
      </div>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2">
        {filteredPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</div>
