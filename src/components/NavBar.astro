---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";

// Normalize: strip base path and trailing slash for matching
const path = currentPath.replace(base, "").replace(/\/$/, "") || "/";

const links = [
  { href: base, label: "主页", match: "/" },
  { href: `${base}/archives`, label: "归档", match: "/archives" },
  { href: `${base}/tags`, label: "标签", match: "/tags" },
  { href: `${base}/about`, label: "关于", match: "/about" },
];
---

<nav id="main-nav" class="relative flex items-center gap-0.5 sm:gap-1 text-sm">
  <!-- 玻璃指示器胶囊 -->
  <span id="nav-pill" class="absolute top-1/2 -translate-y-1/2 h-8 rounded-full -z-10"
    style="transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1);"
  ></span>

  <button
    id="search-toggle"
    class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-text-muted hover:text-text transition-colors cursor-pointer relative z-10"
    aria-label="搜索"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <span class="hidden sm:inline">搜索</span>
  </button>

  {links.map(({ href, label, match }) => (
    <a
      href={href}
      data-nav={match}
      class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-text-muted hover:text-text transition-colors relative z-10"
      class:list={[{ "text-text font-medium": path === match }]}
      aria-label={label}
    >
      <span class="text-xs sm:text-sm">{label}</span>
    </a>
  ))}
</nav>

<script>
  (function() {
    const nav = document.getElementById('main-nav');
    const pill = document.getElementById('nav-pill');
    if (!nav || !pill) return;

    function positionPill() {
      const active = nav.querySelector('[data-nav].text-text');
      const target = active || nav.querySelector('[data-nav]');
      if (!target) return;

      const navRect = nav.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();

      pill.style.left = (targetRect.left - navRect.left) + 'px';
      pill.style.width = targetRect.width + 'px';

      if (active) {
        pill.style.opacity = '1';
      } else {
        pill.style.opacity = '0';
      }
    }

    // Position on load
    requestAnimationFrame(positionPill);

    // Reposition on resize (rAF-throttled)
    let resizeTicking = false;
    window.addEventListener('resize', () => {
      if (!resizeTicking) {
        requestAnimationFrame(() => {
          positionPill();
          resizeTicking = false;
        });
        resizeTicking = true;
      }
    });

    // Hover preview: move pill to hovered item
    nav.querySelectorAll('[data-nav]').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        const navRect = nav.getBoundingClientRect();
        const linkRect = link.getBoundingClientRect();
        pill.style.left = (linkRect.left - navRect.left) + 'px';
        pill.style.width = linkRect.width + 'px';
        pill.style.opacity = '0.55';
      });
      link.addEventListener('mouseleave', () => {
        positionPill();
      });
    });
  })();
</script>
