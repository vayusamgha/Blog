---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, tags } = post.data;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
const { Content, headings } = await post.render();

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

<BaseLayout title={title}>
  <div class="relative max-w-6xl mx-auto">
    <!-- Article -->
    <article class="px-5 py-10 lg:pr-64">
      <header class="mb-10 max-w-3xl mx-auto">
        <a
          href={base}
          class="text-sm text-text-muted hover:text-accent transition-colors mb-4 inline-block"
        >
          ← 返回
        </a>
        <h1 class="text-3xl font-bold text-text mb-3 leading-tight">{title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted">
          <time>
            {date.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          {
            tags.length > 0 && (
              <span class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a
                    href={`${base}/tags/${tag}`}
                    class="text-accent hover:underline"
                  >
                    #{tag}
                  </a>
                ))}
              </span>
            )
          }
        </div>
      </header>

      <div class="prose prose-neutral prose-lg max-w-3xl mx-auto">
        <Content />
      </div>
    </article>

    <!-- TOC sidebar -->
    {
      toc.length > 0 && (
        <aside
          id="toc-sidebar"
          class="hidden lg:block fixed top-24 right-[max(1.5rem,calc((100vw-72rem)/2))] w-56 max-h-[calc(100vh-8rem)] overflow-y-auto"
        >
          <h4 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">
            目录
          </h4>
          <nav>
            <ul class="space-y-0.5 border-l-2 border-border">
              {toc.map((heading) => (
                <li
                  style={`padding-left: ${(heading.depth - 2) * 0.75 + 0.75}rem`}
                >
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class="block py-1 text-sm text-text-muted hover:text-text transition-colors border-l-2 -ml-0.5 pl-3 border-transparent"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  (function () {
    const links = document.querySelectorAll("[data-toc-link]");
    if (links.length === 0) return;

    const headings = [...document.querySelectorAll("article.prose h2, article.prose h3, article.prose h4")];

    const observer = new IntersectionObserver(
      (entries) => {
        // Find the topmost visible heading
        let activeId = null;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
            break;
          }
        }
        // Fallback: use the last heading above the viewport
        if (!activeId) {
          for (let i = entries.length - 1; i >= 0; i--) {
            if (entries[i].boundingClientRect.top < 100) {
              activeId = entries[i].target.id;
              break;
            }
          }
        }

        links.forEach((link) => {
          if (link.dataset.tocLink === activeId) {
            link.classList.add("!text-accent", "!border-accent");
          } else {
            link.classList.remove("!text-accent", "!border-accent");
          }
        });
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );

    headings.forEach((h) => observer.observe(h));
  })();
</script>
