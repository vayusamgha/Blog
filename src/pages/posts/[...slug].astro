---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, tags } = post.data;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
const { Content } = await post.render();
---

<BaseLayout title={title}>
  <article class="max-w-3xl mx-auto px-5 py-10">
    <header class="mb-10">
      <a
        href={base}
        class="text-sm text-text-muted hover:text-accent transition-colors mb-4 inline-block"
      >
        ← 返回
      </a>
      <h1 class="text-3xl font-bold text-text mb-3 leading-tight">{title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted">
        <time>
          {date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        {
          tags.length > 0 && (
            <span class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <a
                  href={`${base}/tags/${tag}`}
                  class="text-accent hover:underline"
                >
                  #{tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <div class="prose prose-neutral prose-lg max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
