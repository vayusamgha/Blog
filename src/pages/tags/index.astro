---
import BaseLayout from "../../components/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getPosts, getTags, getStats, getArchives, getRecentPosts } from "../../utils/posts";

const posts = await getPosts();
const tags = getTags(posts);
const stats = await getStats();
const archives = await getArchives();
const recentPosts = await getRecentPosts(5);
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
---

<BaseLayout title="标签">
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-72 shrink-0 order-2 lg:order-1">
        <Sidebar {posts} {tags} {stats} {archives} {recentPosts} />
      </div>
      <div class="flex-1 min-w-0 order-1 lg:order-2">
        <h1 class="text-2xl font-bold text-text mb-6">所有标签</h1>
        <div class="flex flex-wrap gap-3">
          {tags.map(({ tag, count }) => (
            <a href={`${base}/tags/${tag}`}>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl glass text-text-muted hover:text-accent transition-all duration-200">
                <span class="text-sm font-medium">{tag}</span>
                <span class="text-xs opacity-50">{count}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
