---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, getTags, getStats, getArchives, getRecentPosts, filterByTag } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allPosts = await getPosts();
const filteredPosts = filterByTag(allPosts, tag);
const allTags = getTags(allPosts);
const stats = await getStats();
const archives = await getArchives();
const recentPosts = await getRecentPosts(5);
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";
---

<BaseLayout title={`#${tag}`}>
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-72 shrink-0 order-2 lg:order-1">
        <Sidebar posts={allPosts} tags={allTags} {stats} {archives} {recentPosts} />
      </div>
      <div class="flex-1 min-w-0 order-1 lg:order-2">
        <a
          href={`${base}/tags`}
          class="text-sm text-text-muted hover:text-accent transition-colors mb-4 inline-block no-underline"
        >
          ← 返回标签列表
        </a>
        <article class="prose prose-neutral max-w-none">
        <h1>#{tag} <span class="text-text-muted text-lg font-normal">({filteredPosts.length})</span></h1>
        </article>
        <PostList posts={allPosts} activeTag={tag} />
      </div>
    </div>
  </div>
</BaseLayout>
