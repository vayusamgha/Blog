---
import BaseLayout from "../components/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getPosts, getTags, getStats, getArchives, getRecentPosts } from "../utils/posts";

const posts = await getPosts();
const tags = getTags(posts);
const stats = await getStats();
const archives = await getArchives();
const recentPosts = await getRecentPosts(5);
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "/";

// Group posts by month
const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long" });
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(post);
}
const monthGroups = [...grouped.entries()];
---

<BaseLayout title="归档">
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-72 shrink-0 order-2 lg:order-1">
        <Sidebar {posts} {tags} {stats} {archives} {recentPosts} />
      </div>
      <div class="flex-1 min-w-0 order-1 lg:order-2">
        <article class="prose prose-neutral max-w-none">
        <h1>归档</h1>
        {
          monthGroups.map(([month, monthPosts]) => (
            <section class="mb-8">
              <h3 class="text-lg font-semibold text-text mb-4 pb-2 border-b border-border">
                {month}
                <span class="text-text-muted text-sm font-normal ml-2">({monthPosts.length})</span>
              </h3>
              <ul class="space-y-3">
                {monthPosts.map((post) => (
                  <li class="flex items-baseline gap-3">
                    <time class="text-xs text-text-muted shrink-0 w-10">
                      {post.data.date.getDate()}日
                    </time>
                    <a
                      href={`${base}/posts/${post.slug}`}
                      class="text-sm text-text hover:text-accent transition-colors"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
