---
import BaseLayout from "../components/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getPosts, getTags, getStats, getArchives, getRecentPosts } from "../utils/posts";

const posts = await getPosts();
const tags = getTags(posts);
const stats = await getStats();
const archives = await getArchives();
const recentPosts = await getRecentPosts(5);
---

<BaseLayout title="关于">
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="w-full lg:w-72 shrink-0 order-2 lg:order-1">
        <Sidebar {posts} {tags} {stats} {archives} {recentPosts} />
      </div>
      <div class="flex-1 min-w-0 order-1 lg:order-2">
        <article class="prose prose-neutral prose-lg max-w-none">
          <h1>关于</h1>
          <p>
            这里是 <strong>伐由伽蓝 (VayuSamgha)</strong>，一个记录技术笔记与数学思考的个人博客。
          </p>
          <p>
            博客使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，
            支持 <strong>LaTeX</strong> 数学公式渲染，部署在 GitHub Pages 上。
          </p>
          <h2>关于我</h2>
          <p>
            数学与编程爱好者，主要关注代数几何、范畴论以及函数式编程。
          </p>
          <h2>联系</h2>
          <ul>
            <li>GitHub: <a href="https://github.com/vayusamgha" target="_blank" rel="noopener">@vayusamgha</a></li>
            <li>Email: <a href="mailto:vayusamgha@gmail.com">vayusamgha@gmail.com</a></li>
          </ul>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
